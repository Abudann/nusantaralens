{
    "openapi": "3.0.3",
    "info": {
        "title": "Nusantaralens API",
        "version": "1.0.0",
        "description": "This API serves as the central data provider for Nusantaralens, a platform focused on showcasing Indonesia's rich heritage. It provides structured access to a comprehensive collection of data regarding Indonesian national heroes, cultural diversity, and local languages. Currently, the API is dedicated to retrieval operations (GET), allowing seamless access to these cultural resources.",
        "contact": {
            "name": "Gilang Mayong Saputra",
            "email": "gilang46622@gmail.com"
        },
        "license": {
            "name": "MIT License",
            "url": "https://mit-license.org/"
        }
    },
    "servers": [
        {
            "url": "https://localhost:5000/",
            "description": "Development Server"
        }
    ],
    "paths": {
        "/heroes": {
            "get": {
                "tags": [
                    "Heroes"
                ],
                "summary": "Get All National Heroes Data",
                "description": "Retrieve a complete list of Indonesian national heroes...",
                "responses": {
                    "200": {
                        "description": "Successfully retrieved hero data.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HeroResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Heroes not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "example": {
                                    "status": "failed",
                                    "message": "Heroes not found"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "example": {
                                    "status": "error",
                                    "message": "findAllHeroes is not defined"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/cultures": {
            "get": {
                "tags": [
                    "Cultures"
                ],
                "summary": "Get All Indonesian Cultural Heritage Data",
                "description": "Retrieve a complete list of Indonesian cultures...",
                "responses": {
                    "200": {
                        "description": "Successfully retrieved cultures data.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CultureResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "cultures not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "example": {
                                    "status": "failed",
                                    "message": "cultures not found"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Insernal Server Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "example": {
                                    "status": "error",
                                    "message": "findAllCultures is not defined"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/language/{isoCode}/words": {
            "get": {
                "tags": [
                    "Languages"
                ],
                "summary": "Get a list of words based on the language (ISO) code.",
                "description": "Retrieve a list of regional vocabulary along with their Indonesian translations using the specified language ISO code.",
                "parameters": [
                    {
                        "name": "isoCode",
                        "in": "path",
                        "required": true,
                        "description": "Regional language ISO code (example: ace, jav, abui)",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successfully retrieved language data.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LanguageResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Language is not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "example": {
                                    "status": "failed",
                                    "message": "Language not found"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Insernal Server Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "example": {
                                    "status": "error",
                                    "message": "fidLanguageByIsoCode is not defined"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Hero": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Raden Dewi Sartika"
                    },
                    "ascencionDocumentNumber": {
                        "type": "string",
                        "example": "No Sk 252 Tahun 1966"
                    },
                    "ascencionDocumentDate": {
                        "type": "string",
                        "example": "07 Oktober 1966"
                    },
                    "ascencionYear": {
                        "type": "integer",
                        "example": 1966
                    },
                    "photoUrl": {
                        "type": "string",
                        "example": "https://res.cloudinary.com/..."
                    },
                    "birthDate": {
                        "type": "string",
                        "example": "4 Desember 1884"
                    },
                    "birthPlace": {
                        "type": "string",
                        "example": "Cicalengka, Bandung"
                    },
                    "deathDate": {
                        "type": "string",
                        "example": "11 September 1947"
                    },
                    "deathPlace": {
                        "type": "string",
                        "example": "Tasikmalaya"
                    },
                    "burialPlace": {
                        "type": "string",
                        "example": "Astana Anyar, Bandung"
                    },
                    "description": {
                        "type": "string",
                        "example": "Tokoh perintis pendidikan untuk kaum wanita..."
                    }
                }
            },
            "HeroResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "success"
                    },
                    "message": {
                        "type": "string",
                        "example": "Heroes data retrieved successfully"
                    },
                    "data": {
                        "type": "object",
                        "properties": {
                            "heroes": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/Hero"
                                }
                            }
                        }
                    }
                }
            },
            "Culture": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Wayang Kulit"
                    },
                    "photoUrl": {
                        "type": "string",
                        "example": "https://res.cloudinary.com/..."
                    },
                    "description": {
                        "type": "string",
                        "example": "Wayang Kulit adalah seni pertunjukan tradisional..."
                    }
                }
            },
            "CultureResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "success"
                    },
                    "message": {
                        "type": "string",
                        "example": "Cultures data retrieved successfully"
                    },
                    "data": {
                        "type": "object",
                        "properties": {
                            "cultures": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/Culture"
                                }
                            }
                        }
                    }
                }
            },
            "Word": {
                "type": "object",
                "properties": {
                    "indonesia": {
                        "type": "string",
                        "example": "adik"
                    },
                    "daerah": {
                        "type": "string",
                        "example": "adek"
                    }
                }
            },
            "LanguageResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "success"
                    },
                    "message": {
                        "type": "string",
                        "example": "Get Aceh language successfully"
                    },
                    "data": {
                        "type": "object",
                        "properties": {
                            "words": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/Word"
                                }
                            }
                        }
                    }
                }
            },
            "ErrorResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "description": "Contains `failed` for client errors (4xx) or `error` for server errors (5xx).",
                        "example": "failed"
                    },
                    "message": {
                        "type": "string",
                        "example": "Heroes not found"
                    }
                }
            }
        }
    }
}